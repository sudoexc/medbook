# ---------------------------------------------------------------------------
# MedBook / NeuroFax — env template. Copy to `.env` and fill in real values.
# ---------------------------------------------------------------------------
# Keep this file in version control. Never commit your real `.env`.

# -------------------- Postgres --------------------
# When running docker-compose, use the compose hostname `postgres`. For local
# `npm run dev` pointing at a host Postgres, switch to localhost:5432.
POSTGRES_DB=medbook
POSTGRES_USER=medbook
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgresql://medbook:change-me-long-random@postgres:5432/medbook?schema=public

# -------------------- Redis (BullMQ + SSE fan-out) --------------------
# Empty = fall back to in-memory adapter (single-node dev only).
REDIS_URL=redis://redis:6379

# -------------------- Auth.js (NextAuth v5) --------------------
# Generate: `openssl rand -base64 32`
AUTH_SECRET=change-me-openssl-rand-base64-32
AUTH_URL=https://neurofax.uz
# Public https origin for links the server builds: emails, printed QR codes,
# Telegram Mini App buttons (no button without an https origin).
NEXT_PUBLIC_APP_URL=https://neurofax.uz
PUBLIC_BASE_URL=https://neurofax.uz

# -------------------- App-level secret for AES-GCM encryption --------------------
# Used by src/server/crypto/secrets.ts for ProviderConnection secrets.
# If unset, falls back to AUTH_SECRET. Generate the same way.
APP_SECRET=change-me-openssl-rand-base64-32

# -------------------- Field encryption at rest --------------------
# Patient.passport / notes, MedicalCase.soapDraft, Prescription.notes and TOTP
# secrets. Generate: `openssl rand -base64 32`. Production refuses to start
# without it. Losing it loses those fields: it is saved only inside the
# encrypted restore kit (ops/backup.sh, RUNBOOK §4.5), keep a copy off-server.
# Rotation adds FIELD_ENCRYPTION_KEY_V2 etc. (docs/runbooks/encryption-key-rotation.md).
FIELD_ENCRYPTION_KEY=

# -------------------- 2FA kill-switch --------------------
# When set to "1" or "true", all TOTP enforcement is disabled:
#  - login form never routes to /login/2fa,
#  - enrolled users can sign in with password alone,
#  - proxy stops forcing enrolment on privileged roles.
# NeuroFax production runs with 1 by the owner's decision; keep it when
# restoring, or every privileged account is forced into TOTP enrolment.
DISABLE_2FA=1

# -------------------- Feature switches --------------------
# "1" = the doctor cabinet (/doctor, the daily visit screen) is on. Anything
# else pauses it and doctors land in the CRM. Production needs 1.
DOCTOR_CABINET_ENABLED=1
# "1" / "true" = public clinic signup at /signup. Empty = the route is a 404.
PUBLIC_SIGNUP_ENABLED=

# -------------------- MinIO / S3-compatible storage --------------------
# Empty MINIO_ENDPOINT = dev mode (uploads land in /tmp/uploads).
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=medbook
MINIO_SECRET_KEY=change-me-min-8-chars
MINIO_BUCKET=medbook
# Prefix of the URL saved in rows (`<MINIO_PUBLIC_URL>/<bucket>/<key>`). The
# bucket is private and browsers never fetch this host: the app streams files
# through /api/crm/documents/file and reads only the path back
# (src/lib/storage-ref.ts). nginx has no /files/ location on purpose.
MINIO_PUBLIC_URL=https://neurofax.uz/files
# Optional separate bucket for patient data exports (DSAR). Empty = the
# exports/ prefix inside MINIO_BUCKET (src/server/dsar/expiry.ts).
MINIO_EXPORTS_BUCKET=
# Force path-style addressing (required for MinIO).
MINIO_FORCE_PATH_STYLE=true

# -------------------- Telegram --------------------
# The app has no global bot token: each clinic's bot lives on
# Clinic.tgBotToken (set in the CRM). The watchdog alert bot is separate, see
# ALERT_TG_TOKEN below.
# Base URL Telegram calls back into. Usually the production origin.
TG_WEBHOOK_BASE_URL=https://neurofax.uz
# Bot API base for every app and worker call. Empty = https://api.telegram.org.
# Set it when the host reaches Telegram only through a relay or proxy.
TELEGRAM_API_BASE=
# "true" = the worker long-polls getUpdates instead of relying on webhooks
# (legacy fallback for hosts Telegram cannot call back). Empty = webhooks.
TG_USE_POLLING=

# -------------------- AI (optional) --------------------
# Empty keys = the AI helpers run on a mock provider and log a warning.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# -------------------- Email (SMTP) --------------------
# SMS gateways are configured per clinic in the CRM, not here.
# Used by new-lead emails, public signup confirmation and emailed analytics
# reports. Empty SMTP_USER = email is off: report deliveries fail and a
# schedule switches itself off after 3 failures, signup cannot confirm.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# -------------------- Observability --------------------
# ops/watchdog.sh alerts (health, workers, TLS expiry) go to this Telegram
# chat through this bot. Empty = the watchdog only writes its log.
ALERT_TG_TOKEN=
ALERT_TG_CHAT_ID=
# Optional, when the host cannot reach api.telegram.org directly: a Bot API
# base for the watchdog (defaults to TELEGRAM_API_BASE, else api.telegram.org)
# and a curl proxy URL, e.g. socks5h://127.0.0.1:40000 (WARP in proxy mode).
ALERT_TG_API_BASE=
ALERT_TG_PROXY=
# Hosts whose served certificate the watchdog checks (space separated).
WATCHDOG_CERT_HOSTS=neurofax.uz
# Bearer token for /api/internal/metrics (Prometheus). Empty = the endpoint
# answers 503. Generate: `openssl rand -hex 32`.
METRICS_TOKEN=
# Empty = Sentry disabled (no-op).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# -------------------- Backups (ops/backup.sh, ops/restore.sh) --------------------
# Host directory for the nightly folders (pg dump, clinic files, restore kit).
# Both scripts default to /var/backups/medbook.
BACKUP_DIR=/var/backups/medbook
BACKUP_RETENTION_DAYS=30
# Off-box rsync target for the nightly folder (key-based ssh), e.g.
# u12345@u12345.your-storagebox.de:medbook. Empty = backups stay on this disk.
BACKUP_REMOTE=
# Restore kit (.env + server config), encrypted; set ONE of these or it is
# not saved (RUNBOOK §4.5). Recipient = gpg public key imported on the server
# (preferred: the private key never lives here). Passphrase = symmetric; keep
# it off the server too, or the kit cannot be opened after losing the server.
BACKUP_GPG_RECIPIENT=
BACKUP_PASSPHRASE=

# -------------------- Deployment --------------------
# Consumed by ops/certbot-init.sh
LETSENCRYPT_EMAIL=ops@neurofax.uz
LETSENCRYPT_DOMAIN=neurofax.uz
