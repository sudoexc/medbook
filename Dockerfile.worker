# syntax=docker/dockerfile:1.7
#
# MedBook / NeuroFax — notification & scheduler worker image.
#
# Shares the Dockerfile `builder` stage conceptually, but keeps its own
# build so the worker can ship with `tsx` + the full `src/` tree (the
# Next.js standalone output doesn't include source files outside
# the server bundle).
#
# CMD: `node --import tsx src/server/workers/start.ts`.

FROM node:20-bookworm-slim AS builder
WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# Generate Prisma client in the same image so the worker can talk to Postgres.
RUN npx prisma generate
# Demo, test and QA seeds never run on production (audit G2-02, G2-03):
# production is the real clinic, so keep them out of the image the runner
# copies `scripts/` from. The guard refuses them there too, or demands an
# explicit opt-in (scripts/_destructive-guard.ts), but a script that is not
# in the image cannot be talked into running by a stale note.
RUN rm -f scripts/seed-labs-reminders-dev.ts scripts/seed-doctor-qa.ts \
      scripts/seed-joe-two.ts scripts/seed-clinical-life.ts \
      scripts/total-stress-seed.ts scripts/stress-*.ts \
      scripts/seed-mega-neurofax.ts scripts/wipe-neurofax-demo.ts \
      scripts/seed-today-live.ts scripts/seed-demo-data.ts \
      scripts/seed-prod-demo.ts

FROM node:20-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 1001 nodejs \
 && useradd  --system --uid 1001 --gid nodejs worker

# Copy the full tree from builder (workers need source files + tsx + full node_modules).
# `scripts/` is included so one-shot maintenance scripts (backfills, audits)
# can be run via `docker compose exec worker npx tsx scripts/foo.ts`.
COPY --from=builder --chown=worker:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=worker:nodejs /app/src          ./src
COPY --from=builder --chown=worker:nodejs /app/scripts      ./scripts
COPY --from=builder --chown=worker:nodejs /app/prisma       ./prisma
COPY --from=builder --chown=worker:nodejs /app/package.json ./package.json
COPY --from=builder --chown=worker:nodejs /app/package-lock.json ./package-lock.json
COPY --from=builder --chown=worker:nodejs /app/tsconfig.json ./tsconfig.json
COPY --from=builder --chown=worker:nodejs /app/prisma.config.ts ./prisma.config.ts

USER worker

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["npx", "tsx", "src/server/workers/start.ts"]
